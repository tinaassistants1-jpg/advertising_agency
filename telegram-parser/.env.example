# Ключи из https://my.telegram.org -> API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# Имя файла сессии (создастся как <TG_SESSION>.session)
TG_SESSION=tg_parser

# Телефон в международном формате — чтобы не вводить его при каждом входе
TG_PHONE=+70000000000

# Пауза между тяжёлыми запросами, секунды. Больше значение — меньше риск FloodWait
TG_REQUEST_DELAY=0.7

# Telethon сам подождёт FloodWait короче этого порога, секунды
TG_FLOOD_SLEEP_THRESHOLD=60

# Повторов после длинного FloodWait
TG_MAX_RETRIES=3

# Опциональный прокси: socks5://user:pass@host:1080 или http://host:3128
# TG_PROXY_URL=
