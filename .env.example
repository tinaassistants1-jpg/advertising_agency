# ============================================================
#  Ассистент Дома Maison Tina Riich — переменные окружения
#  Скопируй в .env и заполни. Файл .env в git не попадает.
# ============================================================

# --- Claude (обязательно) ---
# Ключ из console.anthropic.com → Settings → API keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
# Глубина размышления: low | medium | high | xhigh | max
# medium — баланс скорости и качества для чата
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=4000

# --- Telegram (обязательно) ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# --- WhatsApp ---
# Адаптер пока не реализован, см. docs/WHATSAPP.md.
WHATSAPP_ENABLED=false

# --- Долговременная память Дома (GitHub) ---
# Без токена ассистент только читает память; с токеном — пишет журнал,
# идеи, каноны и задачи. Нужен fine-grained PAT с правом Contents: Read and write
# на репозиторий памяти.
GITHUB_TOKEN=
MEMORY_REPO=tinaassistants1-jpg/AI-Creative-OS
MEMORY_BRANCH=main

# --- Прочее ---
DB_PATH=./data/assistant.db
TIMEZONE=Europe/Moscow
# Telegram user id тех, кто может менять настройки чата (через запятую).
# Свой id можно узнать у @userinfobot. Пусто — настройки доступны всем.
ADMIN_IDS=
# Сколько последних сообщений чата уходит в контекст модели
HISTORY_TURNS=24
LOG_LEVEL=info
